# ==============================================================================
# DevSquad Backend Environment Configuration Template
# Copy this file to .env and supply actual values for local development.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# Application Environment (development, staging, production)
DEVSQUAD_ENV=development
DEVSQUAD_HOST=127.0.0.1
DEVSQUAD_PORT=8000
DEVSQUAD_LOG_LEVEL=INFO
DEVSQUAD_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (aiosqlite for local development; postgresql+asyncpg for production)
DEVSQUAD_DATABASE_URL=sqlite+aiosqlite:///./devsquad.db

# LLM Providers Configuration
DEVSQUAD_LLM_PROVIDER=gemini
DEVSQUAD_GEMINI_API_KEY=
DEVSQUAD_GEMINI_MODEL=gemini-2.0-flash
DEVSQUAD_OPENAI_API_KEY=
DEVSQUAD_OPENAI_MODEL=gpt-4o

# GitHub Integration Configuration
DEVSQUAD_GITHUB_TOKEN=
DEVSQUAD_GITHUB_API_URL=https://api.github.com

# Docker Sandbox Configuration
DEVSQUAD_DOCKER_SANDBOX_ENABLED=true
DEVSQUAD_DOCKER_TIMEOUT_SECONDS=120
DEVSQUAD_DOCKER_MEMORY_LIMIT=1g
DEVSQUAD_DOCKER_CPU_LIMIT=1.0

# Execution & Safety Limits
DEVSQUAD_MAX_AGENT_RETRIES=3
DEVSQUAD_MAX_PATCH_SIZE_BYTES=1048576
DEVSQUAD_MAX_REPO_CONTEXT_BYTES=5242880
