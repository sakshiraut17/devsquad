# DevSquad Global Environment Configuration Template

# Server Configuration
PROJECT_NAME="DevSquad AI Engineering Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:3000"

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="devsquad_user"
POSTGRES_PASSWORD="devsquad_password_secure"
POSTGRES_DB="devsquad_db"
DATABASE_URL="postgresql+asyncpg://devsquad_user:devsquad_password_secure@localhost:5432/devsquad_db"

# LLM Provider Configuration
LLM_PROVIDER="gemini" # Options: gemini, openai
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
DEFAULT_MODEL="gemini-1.5-pro"

# GitHub API / OAuth Configuration
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_PERSONAL_ACCESS_TOKEN="your-github-pat-here"

# Security & Tokens
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# Docker Sandbox Settings
DOCKER_SANDBOX_IMAGE="devsquad-sandbox:latest"
DOCKER_CONTAINER_CPU_LIMIT=1.0
DOCKER_CONTAINER_MEMORY_LIMIT="512m"
DOCKER_EXECUTION_TIMEOUT_SECONDS=60
